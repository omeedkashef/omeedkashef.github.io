# Copy this file to .env and fill in the two values, then restart `npm run dev`.
#
# Both come from the Supabase dashboard:
#   Project Settings -> API Keys
#     Project URL             -> VITE_SUPABASE_URL
#     anon / public key       -> VITE_SUPABASE_PUBLISHABLE_KEY
#
# Use ONLY the anon (publishable) key. The service_role / secret key must never
# be placed here — anything VITE_-prefixed is compiled into the public bundle.
#
# .env itself is gitignored and must never be committed. For deployment these
# same two names are stored as GitHub repository secrets and injected by
# .github/workflows/deploy.yml at build time.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
